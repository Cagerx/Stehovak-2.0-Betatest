{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Represents a worker or employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "photo": { "type": "string" },
        "licenseInfo": { "type": "string" }
      },
      "required": ["id", "name", "phone", "role", "status"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Represents a vehicle in the fleet.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plate": { "type": "string" },
        "model": { "type": "string" },
        "capacity": { "type": "string" },
        "status": { "type": "string" },
        "vin": { "type": "string" },
        "stkExpiration": { "type": "string" },
        "vignetteExpiration": { "type": "string" },
        "insuranceInfo": { "type": "string" },
        "carImage": { "type": "string" },
        "techCertImage": { "type": "string" },
        "tireSize": { "type": "string" },
        "tireType": { "type": "string" },
        "tireDepth": { "type": "string" }
      },
      "required": ["id", "plate", "model", "capacity", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a financial transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "method": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "type", "amount", "description", "category", "method", "date", "userId", "userName"]
    },
    "MoveTask": {
      "title": "MoveTask",
      "description": "Represents a moving task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "customer": { "type": "string" },
        "customerPhone": { "type": "string" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "assignedWorkers": { "type": "array" },
        "assignedVehicles": { "type": "array" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "title", "customer", "start", "end", "status"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Represents company information settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "taxId": { "type": "string" },
        "vatId": { "type": "string" },
        "website": { "type": "string" },
        "logoUrl": { "type": "string" }
      },
      "required": ["name", "address", "phone", "email"]
    },
    "MaintenanceRequest": {
      "title": "MaintenanceRequest",
      "description": "Represents a maintenance request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["id", "reason", "userId", "userName", "createdAt", "status"]
    }
  },
  "firestore": {
    "/settings/company": {
      "schema": { "$ref": "CompanySettings" },
      "description": "Company information document."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "MoveTask" },
      "description": "Collection of moving tasks."
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "Worker" },
      "description": "Collection of workers."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "Vehicle" },
      "description": "Collection of vehicles."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "Transaction" },
      "description": "Collection of financial transactions."
    },
    "/maintenanceRequests/{requestId}": {
      "schema": { "$ref": "MaintenanceRequest" },
      "description": "Collection of maintenance requests."
    }
  }
}
